{
  auto_https disable_redirects
}

http://{$DOMAIN} {
  redir https://{$DOMAIN}{uri}
}

http://{$ROULETTE_DOMAIN} {
  redir https://{$ROULETTE_DOMAIN}{uri}
}

http://{$PIC_MOMENT_DOMAIN} {
  redir https://{$PIC_MOMENT_DOMAIN}{uri}
}

{$DOMAIN} {
  encode gzip zstd

  @waiting path {$WAITING_ROOM_PATH:/__waiting_disabled__}
  handle @waiting {
    header Cache-Control "no-store"
    header Retry-After "20"
    respond "Service is temporarily busy. Please try again shortly." 503
  }

  @api path /api/* /ws/*
  @static path /favicon.ico /robots.txt /sitemap.xml /manifest.webmanifest /apple-touch-icon.png /apple-touch-icon-precomposed.png
  @nextStatic path /_next/static/*
  @themeImages path /theme-images/*
  header @api Cache-Control "no-store"
  header @static Cache-Control "public, max-age=3600"
  header @nextStatic Cache-Control "public, max-age=31536000, immutable"
  header @themeImages Cache-Control "public, max-age=2592000"

  reverse_proxy cardinvitation:3000
}

{$ROULETTE_DOMAIN} {
  encode gzip zstd
  header Cache-Control "public, max-age=3600"
  reverse_proxy {$ROULETTE_UPSTREAM:roulette-physics:80}
}

{$PIC_MOMENT_DOMAIN} {
  encode gzip zstd
  reverse_proxy pic-moment:3000
}

http://{$HOST_IP}, http://localhost {
  encode gzip zstd
  reverse_proxy cardinvitation:3000
}
